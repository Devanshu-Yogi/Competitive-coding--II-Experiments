class Solution(object):
    def containsNearbyDuplicate(self, nums, k):
        dict = {}
        for i in range(0,len(nums)):
            if nums[i] in dict and abs(i-dict[nums[i]]) <= k: 
                return True
            dict[nums[i]]=i
        return False
